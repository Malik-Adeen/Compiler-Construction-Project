options {
  STATIC = false;
  DEBUG_PARSER = false;
}

PARSER_BEGIN(CLParser)

import java.io.*;

public class CLParser {
  static SymbolTable st = new SymbolTable();
  static SimpleNode programAST;
  
  public static void main(String[] args) {
    try {
      InputStream input = System.in;
      
      if (args.length > 0) {
        input = new FileInputStream(args[0]);
        System.out.println("Reading from file: " + args[0]);
      } else {
        System.out.println("Reading from standard input...");
      }
      
      CLParser parser = new CLParser(input);
      programAST = parser.StartProgram();
      System.out.println("\n✓ Parsing completed successfully!");
      
      
      System.out.println("\n" + "=".repeat(70));
      System.out.println("PHASE 1: SEMANTIC ANALYSIS");
      System.out.println("=".repeat(70));
      
      SemanticAnalyzer semanticAnalyzer = new SemanticAnalyzer(st);
      boolean semanticValid = semanticAnalyzer.analyze(programAST);
      semanticAnalyzer.printReport();
      
      if (!semanticValid) {
        System.out.println("\n✗ Semantic analysis failed. Stopping compilation.");
        System.exit(1);
      }
      
      
      System.out.println("\nSymbol Table:");
      st.print();
      
      
      System.out.println("\n" + "=".repeat(70));
      System.out.println("PHASE 2: INTERMEDIATE CODE GENERATION");
      System.out.println("=".repeat(70) + "\n");
      
      IRGenerator irGenerator = new IRGenerator(st);
      irGenerator.generateFromAST(programAST);
      IntermediateRepresentation ir = irGenerator.getIR();
      ir.print();
      
      
      System.out.println("\n" + "=".repeat(70));
      System.out.println("PHASE 3: CODE OPTIMIZATION");
      System.out.println("=".repeat(70));
      
      IROptimizer optimizer = new IROptimizer(ir);
      IntermediateRepresentation optimizedIR = optimizer.optimize();
      optimizer.printOptimizationReport();
      optimizedIR.print();
      
      
      System.out.println("\n" + "=".repeat(70));
      System.out.println("PHASE 4: ASSEMBLY CODE GENERATION");
      System.out.println("=".repeat(70));
      
      AssemblyCodeGenerator asmGenerator = new AssemblyCodeGenerator(optimizedIR, st);
      asmGenerator.generate();
      asmGenerator.printAssemblyCode();
      System.out.println(asmGenerator.getStatistics());
      
      System.out.println("\n✓ Compilation completed successfully!");
      
    } catch (ParseException e) {
      System.err.println("Syntax Error: " + e.getMessage());
      System.exit(1);
    } catch (TokenMgrError e) {
      System.err.println("Lexical Error: " + e.getMessage());
      System.exit(1);
    } catch (FileNotFoundException e) {
      System.err.println("File not found: " + e.getMessage());
      System.exit(1);
    } catch (Exception e) {
      System.err.println("Error: " + e.getMessage());
      e.printStackTrace();
      System.exit(1);
    }
  }
}

PARSER_END(CLParser)

SKIP :
{
  " " | "\t" | "\n" | "\r"
}

TOKEN : /* KEYWORDS */
{
  < STARTPROGRAM: "startProgram" >
| < ENDPROGRAM: "endProgram" >
| < VARIABLES: "variables" >
| < CODE: "code" >
| < INT: "int" >
| < FLOAT: "float" >
| < STRING: "string" >
| < CHAR: "char" >
| < OUTSTRING: "outString" >
| < LOOPIF: "loopif" >
| < HOLDS: "holds" >
| < ENDLOOP: "endloop" >
| < SWITCHFOR: "switchFor" >
| < CASE: "case" >
| < OTHER: "other" >
| < ENDSWITCHFOR: "endswitchFor" >
}

TOKEN : /* LITERALS */
{
  < FLOAT_LITERAL: (["0"-"9"])+ "." (["0"-"9"])+ >
| < INTEGER: (["0"-"9"])+ >
| < CHAR_LITERAL: "'" (~["'"])? "'" >
| < IDENTIFIER: ["a"-"z","A"-"Z"] (["a"-"z","A"-"Z","0"-"9","_"])* >
| < STRING_LITERAL: "\"" (~["\""])* "\"" >
}

TOKEN : /* OPERATORS */
{
  < ASSIGN: "=" >
| < PLUS: "+" >
| < MINUS: "-" >
| < MULTIPLY: "*" >
| < DIVIDE: "/" >
| < GT: ">" >
| < LT: "<" >
| < GTE: ">=" >
| < LTE: "<=" >
| < EQ: "==" >
| < NEQ: "<>" >
}

TOKEN : /* DELIMITERS */
{
  < SEMICOLON: ";" >
| < COLON: ":" >
| < LPAREN: "(" >
| < RPAREN: ")" >
}

// --- GRAMMAR PRODUCTIONS ---

SimpleNode StartProgram() :
{
  SimpleNode stmtNode;
  int childIndex = 0;
}
{
  <STARTPROGRAM>
  <VARIABLES> <COLON>
  VariableDeclarations()
  <CODE> <COLON>
  ( stmtNode=Statement() 
    {
      jjtThis.jjtAddChild(stmtNode, childIndex++);
    }
  )* 
  <ENDPROGRAM>
  {
    return jjtThis;
  }
}

void VariableDeclarations() : {}
{
  ( VarDeclaration() )* 
}

SimpleNode VarDeclaration() :
{
    Token tType, tName, tValue;
}
{
    ( tType=<INT> | tType=<FLOAT> | tType=<STRING> | tType=<CHAR> )
    tName=<IDENTIFIER>
    <ASSIGN>
    ( tValue=<INTEGER> | tValue=<FLOAT_LITERAL> | tValue=<STRING_LITERAL> | tValue=<CHAR_LITERAL> )
    <SEMICOLON>
    {
        jjtThis.value = tName.image;
        jjtThis.setType(tType.image);

        if (st.containsKey(tName.image)) {
            throw new ParseException("Semantic Error: Variable '" + tName.image + "' already declared.");
        }
        st.put(tName.image, tType.image, tValue.image);
        return jjtThis;
    }
}

SimpleNode Statement() :
{
  SimpleNode stmt;
}
{
  LOOKAHEAD(2)
  stmt=AssignmentStatement() { return stmt; }
| stmt=OutStringStatement() { return stmt; }
| stmt=LoopIfStatement() { return stmt; }
| stmt=SwitchForStatement() { return stmt; }
}

SimpleNode SimpleStatement() :
{
  SimpleNode stmt;
}
{
  LOOKAHEAD(2)
  stmt=AssignmentStatement() { return stmt; }
| stmt=OutStringStatement() { return stmt; }
}

SimpleNode AssignmentStatement() #AssignmentStatement :
{
    Token tName;
    SimpleNode exprNode;
}
{
    tName=<IDENTIFIER> <ASSIGN> exprNode=Expression() <SEMICOLON>
    {
        if (!st.containsKey(tName.image)) {
            throw new ParseException("Semantic Error: Variable '" + tName.image + "' not declared at line " + tName.beginLine);
        }

        String varType = st.getType(tName.image);
        String exprType = ((SimpleNode) exprNode.jjtGetChild(0)).getType();

        if (!varType.equals(exprType) && !exprType.equals("unknown")) {
            throw new ParseException("Semantic Error: Type mismatch at line " + tName.beginLine +
                                     ". Cannot assign " + exprType + " to " + varType + ".");
        }
        
        jjtThis.value = tName.image;
        jjtThis.jjtAddChild(exprNode, 0);
        return jjtThis;
    }
}

SimpleNode Expression() :
{
    SimpleNode t1, t2;
    Token op = null;
}
{
    t1=Term()
    (
        ( op=<PLUS> | op=<MINUS> ) t2=Term()
        {
            jjtThis.jjtAddChild(t1, 0);
            jjtThis.jjtAddChild(t2, 1);
            
            String leftType  = ((SimpleNode) jjtThis.jjtGetChild(0)).getType();
            String rightType = ((SimpleNode) jjtThis.jjtGetChild(1)).getType();
            if (leftType.equals("string") || rightType.equals("string")) {
                throw new ParseException("Semantic Error: Cannot use +/- on strings at line " + op.beginLine);
            }
        }
    )*
    {
        jjtThis.setType(t1.getType());
        return jjtThis;
    }
}

SimpleNode Term() :
{
    SimpleNode t1, t2;
    Token op = null;
}
{
    t1=Factor()
    (
        ( op=<MULTIPLY> | op=<DIVIDE> ) t2=Factor()
        {
            jjtThis.jjtAddChild(t1, 0);
            jjtThis.jjtAddChild(t2, 1);
            
            String leftType  = ((SimpleNode) jjtThis.jjtGetChild(0)).getType();
            String rightType = ((SimpleNode) jjtThis.jjtGetChild(1)).getType();
            if (leftType.equals("string") || rightType.equals("string")) {
                throw new ParseException("Semantic Error: Cannot use */÷ on strings at line " + op.beginLine);
            }
        }
    )*
    {
        jjtThis.setType(t1.getType());
        return jjtThis;
    }
}

SimpleNode Factor() :
{
    Token t;
}
{
    t=<INTEGER>
    {
        jjtThis.value = t.image;
        jjtThis.setType("int");
        return jjtThis;
    }
|   t=<FLOAT_LITERAL>
    {
        jjtThis.value = t.image;
        jjtThis.setType("float");
        return jjtThis;
    }
|   t=<STRING_LITERAL>
    {
        jjtThis.value = t.image;
        jjtThis.setType("string");
        return jjtThis;
    }
|   t=<CHAR_LITERAL>
    {
        jjtThis.value = t.image;
        jjtThis.setType("char");
        return jjtThis;
    }
|   t=<IDENTIFIER>
    {
        if (!st.containsKey(t.image)) {
            throw new ParseException("Semantic Error: Variable '" + t.image + "' not declared at line " + t.beginLine);
        }
        String resolvedType = st.getType(t.image);
        jjtThis.value = t.image;
        jjtThis.setType(resolvedType);
        return jjtThis;
    }
|   <LPAREN> { SimpleNode inner = Expression(); jjtThis.setType(inner.getType()); } <RPAREN> { return jjtThis; }
}

SimpleNode OutStringStatement() #OutStringStatement :
{
  SimpleNode exprNode;
}
{
  <OUTSTRING> <LPAREN> 
  exprNode=Expression() 
  <RPAREN> <SEMICOLON>
  {
    jjtThis.jjtAddChild(exprNode, 0);
    return jjtThis;
  }
}

SimpleNode LoopIfStatement() #LoopIfStatement :
{
  SimpleNode condNode;
  SimpleNode stmtNode;
  int childIndex = 1;
}
{
  <LOOPIF> condNode=Condition() <HOLDS>
  ( stmtNode=SimpleStatement()
    {
      jjtThis.jjtAddChild(stmtNode, childIndex++);
    }
  )+ 
  <ENDLOOP>
  {
    jjtThis.jjtAddChild(condNode, 0);
    return jjtThis;
  }
}

SimpleNode SwitchForStatement() : 
{ Token tVar; }
{
  <SWITCHFOR> <LPAREN> tVar=<IDENTIFIER> <RPAREN>
  {
    // Check if variable exists
    if (!st.containsKey(tVar.image)) {
      throw new ParseException("Semantic Error: Variable '" + tVar.image + 
                               "' not declared in switchFor at line " + tVar.beginLine);
    }
    // Get variable type
    String varType = st.getType(tVar.image);
    if (!varType.equals("int") && !varType.equals("string")) {
      throw new ParseException("Semantic Error: SwitchFor variable must be int or string type at line " + tVar.beginLine);
    }
  }
  ( CaseClause() )+
  ( OtherClause() )?  
  <ENDSWITCHFOR>
  {
    jjtThis.value = tVar.image;
    return jjtThis;
  }
}

void CaseClause() : {}
{
  <CASE> ( <INTEGER> | <STRING_LITERAL> ) <COLON> ( SimpleStatement() )+  
}

void OtherClause() : {}
{
  <OTHER> <COLON> ( SimpleStatement() )+  
}

SimpleNode Condition() #Condition : 
{ Token t; }
{
  ( t=<IDENTIFIER> 
    {
      // Check if variable exists in condition
      if (!st.containsKey(t.image)) {
        throw new ParseException("Semantic Error: Variable '" + t.image + 
                                 "' not declared in condition at line " + t.beginLine);
      }
      jjtThis.value = t.image;
    }
  | t=<INTEGER> 
    {
      jjtThis.value = t.image;
    }
  ) 
  ( <GT> | <LT> | <GTE> | <LTE> | <EQ> | <NEQ> ) 
  ( t=<IDENTIFIER>
    {
      // Check if variable exists in condition
      if (!st.containsKey(t.image)) {
        throw new ParseException("Semantic Error: Variable '" + t.image + 
                                 "' not declared in condition at line " + t.beginLine);
      }
    }
  | t=<INTEGER> 
  )
  {
    return jjtThis;
  }
}